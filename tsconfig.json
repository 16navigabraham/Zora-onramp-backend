{
  "compilerOptions": {
  "module": "NodeNext",
  "moduleResolution": "NodeNext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
  "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
  // Note: 'baseUrl' was removed because it's deprecated for TypeScript 7.0+.
  // The editor may still show a diagnostic about this. To resolve that you
  // can either upgrade the workspace TypeScript to a version that supports
  // the 'ignoreDeprecations' option, or accept this warning until you
  // migrate imports away from baseUrl usage. We intentionally avoid setting
  // 'ignoreDeprecations' here because the project's TypeScript version
  // (used by CI and local tooling) does not accept that option and it
  // causes TS5103 errors.
    "incremental": true,
  "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
