# Environment Configuration
NODE_ENV=production

# PostgreSQL Connection (OLD - for data export only)
DATABASE_URL=postgresql://user:password@host:5432/database

# MongoDB Connection (NEW)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/zora-onramp?retryWrites=true&w=majority

# Server Configuration
PORT=3000

# Blockchain Configuration
RPC_URL=https://base-mainnet.g.alchemy.com/v2/your-api-key
PRIVATE_KEY=your-private-key-here
CONTRACT_ADDRESS=0x682ead9c2B10Cde16c9014943d918165B64316B6

# Flutterwave Configuration
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
FLUTTERWAVE_ENCRYPTION_KEY=your-flutterwave-encryption-key
FLUTTERWAVE_WEBHOOK_SECRET=your-webhook-secret

# Neynar API Configuration (for Farcaster)
NEYNAR_API_KEY=your-neynar-api-key

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-app.onrender.com/api/telegram/webhook
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id

# Application Configuration
USDC_TO_NGN_RATE=1600
ORDER_EXPIRY_MINUTES=15
MIN_ORDER_AMOUNT_NGN=1000
MAX_ORDER_AMOUNT_NGN=1000000

# Balance Monitoring
BALANCE_CHECK_INTERVAL_MINUTES=180
BALANCE_THRESHOLD_USDC=0.5
